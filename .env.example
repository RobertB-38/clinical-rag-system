# Copy to .env and fill in. All settings are optional except the API key
# (needed only for Claude generation; retrieval works without it).

RAG_ANTHROPIC_API_KEY=sk-ant-...

# Added in Phase 4 for the cheap-tier router model (Mixed Claude + GPT):
# OPENAI_API_KEY=sk-...

# Providers: real defaults shown. Use fakes for offline/dev.
# RAG_EMBEDDING_PROVIDER=minilm   # or: fake
# RAG_VECTOR_STORE=chroma         # or: memory
# RAG_LLM_PROVIDER=claude         # or: fake

# Tuning
# RAG_CLAUDE_MODEL=claude-haiku-4-5-20251001
# RAG_TOP_K=4
# RAG_SCORE_THRESHOLD=0.25
